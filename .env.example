# Claude API key. Leave empty to show calculation results only (no AI reading).
ANTHROPIC_API_KEY=
# Optional: override the model used for readings (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# ── 결제(토스페이먼츠 "API 개별 연동 키": test_ck_/test_sk_ 또는 live_ck_/live_sk_) ──
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 휴대폰 결제(토스페이먼츠와 휴대폰 결제 계약 후 1로). 켜면 구매 상자에서 "카드·간편결제 / 휴대폰 결제"를 고를 수 있다
# TOSS_MOBILE_PHONE=1

# ── 주문·리포트 저장소(Upstash Redis). Vercel → Storage → Upstash(Redis) 연결 시 자동으로 들어온다 ──
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── 선택: 결제 후 리포트 링크 메일(Resend). MAIL_FROM은 Resend에서 인증한 도메인 주소 ──
# RESEND_API_KEY=
# MAIL_FROM=천기록 <report@your-domain.kr>

# 선택: 메일 속 링크에 쓸 사이트 주소(없으면 접속한 주소)
# SITE_URL=https://your-domain.kr

# 선택: 1이면 결제 없이 예전처럼 생년월일만으로 AI 풀이 제공(무료 운영·기존 앱 호환)
# FREE_READING=1

# 카카오톡 채널 1:1 상담 주소(예: https://pf.kakao.com/_AbCdE). 넣으면 홈에 '카톡 상담' 버튼이 생긴다
# NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# Android 앱 전용 화면(/app)의 무료 풀이 접근 키(영문·숫자 16자 이상). 앱 빌드 때 SAJU_APP_KEY와 같은 값을 쓴다.
# 비우면 앱에서도 명식·등급 계산까지만 보인다.
APP_ACCESS_KEY=

# 무료 풀이(앱 전용 화면·FREE_READING) 횟수 제한, 감정서 부 수 기준. 비우면 아래 기본값.
# 각 한도에는 실패한 파트를 다시 쓸 수 있도록 1부만큼 여유가 더해진다. 결제한 감정서는 제한하지 않는다.
# 정확히 세려면 Upstash(KV_REST_API_URL·KV_REST_API_TOKEN)가 연결되어 있어야 한다.
# FREE_LIMIT_PER_HOUR=3
# FREE_LIMIT_PER_DAY=5
# FREE_LIMIT_GLOBAL_PER_DAY=50

# 감정서 파일(PDF·HTML) 발송 예약: Upstash QStash (Upstash 콘솔 > QStash에서 복사)
# 세 값이 모두 있으면 신청 10분 뒤에 이메일(PDF·HTML 첨부)과 카카오톡·문자(파일 받기 링크)를 고른 곳 모두로 보낸다.
# 없으면 감정서가 완성되는 즉시 보낸다.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=                 # 콘솔에 지역별 주소가 따로 보이면 그 값(없으면 비움)
# DELIVERY_DELAY_MINUTES=10   # 파일 발송까지 기다릴 분(기본 10)
# WEB_REVEAL_MINUTES=3        # 화면에 감정서를 펼치기까지 기다릴 분(기본 3)
# SITE_URL=https://saju-reading-azure.vercel.app   # 예약·링크에 쓸 사이트 주소(권장)

# 카카오톡 알림톡 템플릿(솔라피에서 등록, 카카오 검수 필요). 없으면 카카오톡을 고른 손님에게 문자로 대신 보낸다.
# KAKAO_PF_ID=
# KAKAO_RECEIPT_TEMPLATE_ID=   # 결제 확인(주문번호·결제 내역): src/lib/receipt.ts의 RECEIPT_KAKAO_TEMPLATE 문구
# KAKAO_TEMPLATE_ID=           # 감정서 파일 발송(10분 뒤까지 저장하지 않은 손님): src/lib/sms.ts의 KAKAO_TEMPLATE 문구
