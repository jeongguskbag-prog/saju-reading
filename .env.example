# Claude API key. Leave empty to show calculation results only (no AI reading).
ANTHROPIC_API_KEY=
# Optional: override the model used for readings (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# ── 결제(토스페이먼츠 "API 개별 연동 키": test_ck_/test_sk_ 또는 live_ck_/live_sk_) ──
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 휴대폰 결제(토스페이먼츠와 휴대폰 결제 계약 후 1로). 켜면 구매 상자에서 "카드·간편결제 / 휴대폰 결제"를 고를 수 있다
# TOSS_MOBILE_PHONE=1

# ── 주문·리포트 저장소(Upstash Redis). Vercel → Storage → Upstash(Redis) 연결 시 자동으로 들어온다 ──
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── 선택: 결제 후 리포트 링크 메일(Resend). MAIL_FROM은 Resend에서 인증한 도메인 주소 ──
# RESEND_API_KEY=
# MAIL_FROM=천기록 <report@your-domain.kr>

# 선택: 메일 속 링크에 쓸 사이트 주소(없으면 접속한 주소)
# SITE_URL=https://your-domain.kr

# 선택: 1이면 결제 없이 예전처럼 생년월일만으로 AI 풀이 제공(무료 운영·기존 앱 호환)
# FREE_READING=1

# 카카오톡 채널 1:1 상담 주소(예: https://pf.kakao.com/_AbCdE). 넣으면 홈에 '카톡 상담' 버튼이 생긴다
# NEXT_PUBLIC_KAKAO_CHANNEL_URL=
